digraph {
    graph [
        layout=dot,
        rankdir=TB,
        label="Syndicationd application topology",
        labelloc="top",
        labeljust="left",
        fontname="Helvetica,Arial,sans-serif",
        compound=true,
        newrank=true,
        nodesep=0.55,
        ranksep=0.8
    ];

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#f8fafc",
        color="#64748b",
        fontname="Helvetica,Arial,sans-serif",
        margin="0.12,0.08"
    ];

    edge [
        color="#475569",
        fontname="Helvetica,Arial,sans-serif",
        fontsize=10,
        arrowsize=0.7
    ];

    user [
        label="User",
        shape=oval,
        fillcolor="#f1f5f9"
    ];

    subgraph cluster_app {
        label="User process";
        color="#cbd5e1";
        style="rounded";

        synd [ label="synd\nCLI + config" ];
        term [ label="synd_term\nTUI application" ];
        feed_commands [ label="feed subcommands\nimport/export" ];
    }

    subgraph cluster_runtime {
        label="Runtime boundary";
        color="#cbd5e1";
        style="rounded";

        runtime [ label="synd_runtime\nsession acquisition" ];
        session [ label="Session\nclient + close handle" ];
        client [ label="synd_client\nlocal API client" ];
        daemon [ label="singleton daemon\nsynd daemon serve" ];
    }

    subgraph cluster_api {
        label="Daemon process";
        color="#cbd5e1";
        style="rounded";

        api [ label="synd_api\nlocal API surface" ];
        protocol [ label="synd_protocol\nsession contracts" ];
    }

    subgraph cluster_domain {
        label="Domain and storage";
        color="#cbd5e1";
        style="rounded";

        registry [ label="synd_registry\nfeed registry workflow" ];
        persistence [ label="synd_persistence\nSQLite adapters" ];
        sqlite [ label="SQLite DB", shape=cylinder ];
        feed_sources [ label="Feed sources", shape=oval ];
    }

    user -> synd [ label="runs" ];
    synd -> runtime [ label="resolve config\nacquire session" ];
    runtime -> daemon [ label="start/replace\nwhen needed" ];
    daemon -> api [ label="hosts" ];
    runtime -> api [ label="open/close session" ];
    runtime -> session [ label="returns" ];
    session -> client [ label="contains" ];

    synd -> term [ label="interactive mode" ];
    synd -> feed_commands [ label="feed CLI mode" ];
    term -> client [ label="queries/subscribes" ];
    feed_commands -> client [ label="commands/queries" ];

    client -> api [ label="GraphQL/local HTTP" ];
    api -> protocol [ label="implements" ];
    api -> registry [ label="serves commands" ];
    registry -> persistence [ label="persists state" ];
    registry -> feed_sources [ label="refreshes" ];
    persistence -> sqlite [ label="reads/writes" ];
}
