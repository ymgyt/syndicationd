digraph {
    graph [
        layout=dot,
        rankdir=BT,
        label="Syndicationd packages overview",
        labelloc="top", // t(top) | b(bottom)
        labeljust="left", // l(left) | c(center) | r(right)
        fontname="Helvetica,Arial,sans-serif"
        compound=true; 
        newrank=true
    ];

    support [ label="synd_support" ]
    protocol [ label="synd_protocol" ]
    auth [ label="synd_auth" ]
    feed [ label="synd_feed" ]
    registry [ label="synd_registry" ]
    persistence [ label="synd_persistence" ]
    client [ label="synd_client" ]
    runtime [ label="synd_runtime" ]
    test [ label="synd_test" ]

    synd [ label="synd", shape="box" ]
    term [ label="synd_term", shape="box" ]
    api  [ label="synd_api", shape="box" ]

    synd -> support [ headport="se" ]
    synd -> persistence
    synd -> client
    synd -> runtime
    synd -> term

    term -> support [ headport="se" ]
    term -> auth
    term -> feed
    term -> client

    runtime -> support [ headport="se" ]
    runtime -> protocol
    runtime -> feed
    runtime -> registry
    runtime -> persistence
    runtime -> client
    runtime -> api

    api  -> support [ headport="se" ]
    api  -> protocol
    api  -> auth
    api  -> feed
    api  -> registry
    api  -> persistence
    api  -> test [ style="dotted" ]

    client -> support [ headport="se" ]
    client -> protocol
    client -> feed

    persistence -> feed
    persistence -> registry

    registry -> feed

    test -> auth
}
