{
	"project": {
		"name": "synd"
	},
	"build": {
		"static_dir": "etc/website/assets",
		"dist_dir": "website"
	},
	"styles": {
		"theme": "axo_dark",
		"favicon": "https://blog.ymgyt.io/favicon.ico"
	},
	"marketing": {
		"social": {
			"image": "https://blog.ymgyt.io/images/emoji/crab.png",
			"image_alt": "synd",
			"twitter_account": "@YAmaguchixt"
		}
	},
	"components": {
		"changelog": {
			"read_changelog_file": false
		},
		"mdbook": {
			"path": "../../docs/mdbook"
		},
		"artifacts": {
				"package_managers": {
					"additional": {
						"nix": "nix profile add github:ymgyt/syndicationd/v0.4.0#synd",
						"cargo": "cargo install synd --version 0.4.0 --locked",
						"docker": "docker run --rm -it ghcr.io/ymgyt/synd:0.4.0"
					}
				}
		}
	}
}
