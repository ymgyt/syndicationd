                ],
            },
        },
    ),
    keys: Some(
        KeymapConfig {
            bindings: {
                Entries: [
                    KeyBinding {
                        on: KeySequence {
                            keys: [
                                KeyStroke {
                                    code: Char(
                                        'j',
                                    ),
                                    modifiers: KeyModifiers(
                                        0x0,
                                    ),
                                },
                            ],
                        },
                        command: MoveEntryNext,
                        desc: Some(
                            "Next entry",
                        ),
                    },
                    KeyBinding {
                        on: KeySequence {
                            keys: [
                                KeyStroke {
                                    code: Char(
                                        'g',
                                    ),
                                    modifiers: KeyModifiers(
                                        0x0,
                                    ),
                                },
                                KeyStroke {
                                    code: Char(
                                        'g',
                                    ),
                                    modifiers: KeyModifiers(
                                        0x0,
                                    ),
                                },
                            ],
                        },
                        command: MoveEntryFirst,
                        desc: Some(
                            "Go to first entry",
                        ),
                    },
                    KeyBinding {
                        on: KeySequence {
