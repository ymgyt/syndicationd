---
source: crates/synd/src/config/file.rs
expression: config
---
ConfigFile {
    cache: Some(
        CacheEntry {
            directory: Some(
                "/tmp/synd/cache",
            ),
        },
    ),
    log: Some(
        LogEntry {
            path: Some(
                "/tmp/synd/synd.log",
            ),
        },
    ),
    theme: Some(
        ThemeEntry {
            name: Some(
                Ferra,
            ),
            background: None,
        },
    ),
    backend: Some(
        BackendEntry {
            sqlite_db: Some(
                "/tmp/synd/synd.db",
            ),
        },
    ),
    api: Some(
        ApiEntry {
            timeout: Some(
                30s,
            ),
        },
    ),
    daemon: Some(
        DaemonEntry {
            runtime_root: Some(
                "/tmp/synd/runtime",
            ),
            session_lease_duration: Some(
                60s,
            ),
            session_idle_shutdown_grace: Some(
                120s,
            ),
        },
    ),
    feed: Some(
        FeedEntry {
            entries_limit: Some(
                100,
            ),
            browser: Some(
                FeedBrowserEntry {
                    command: Some(
                        "w3m",
                    ),
                    args: Some(
                        [
                            "--foo",
                            "--bar",
                        ],
                    ),
                },
            ),
        },
    ),
    gh: Some(
        GhEntry {
            enable: Some(
                true,
            ),
            pat: Some(
                "ghp_xxxx",
            ),
        },
    ),
    categories: Some(
        {
            "rust": CategoryConfig {
                icon: Icon {
                    symbol: "S",
                    color: Some(
                        IconColor {
                            rgb: Some(
                                16206848,
                            ),
                            name: None,
                            color: None,
                        },
                    ),
                },
                aliases: [
                    "rs",
                ],
            },
        },
    ),
    keys: Some(
        KeymapConfig {
            layers: {
                Entries: LayerConfig {
                    keymap: [
                        Binding {
                            on: KeySequence {
                                keys: [
                                    KeyStroke {
                                        code: Char(
                                            'j',
                                        ),
                                        modifiers: KeyModifiers(
                                            0x0,
                                        ),
                                    },
                                ],
                            },
                            command: MoveEntryNext,
                            desc: Some(
                                "Next entry",
                            ),
                        },
                        Binding {
                            on: KeySequence {
                                keys: [
                                    KeyStroke {
                                        code: Char(
                                            'g',
                                        ),
                                        modifiers: KeyModifiers(
                                            0x0,
                                        ),
                                    },
                                    KeyStroke {
                                        code: Char(
                                            'g',
                                        ),
                                        modifiers: KeyModifiers(
                                            0x0,
                                        ),
                                    },
                                ],
                            },
                            command: MoveEntryFirst,
                            desc: Some(
                                "Go to first entry",
                            ),
                        },
                        Binding {
                            on: KeySequence {
                                keys: [
                                    KeyStroke {
                                        code: Up,
                                        modifiers: KeyModifiers(
                                            0x0,
                                        ),
                                    },
                                ],
                            },
                            command: Nop,
                            desc: None,
                        },
                    ],
                },
            },
        },
    ),
}
