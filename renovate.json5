{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "enabledManagers": ["cargo", "github-actions"],
  "automerge": true,
  "reviewersFromCodeOwners": true,
  "reviewersSampleSize": 1,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  // This is an allowed update window, not a trigger schedule. Keep it wide so
  // the hosted Renovate app can create update branches when it runs.
  "schedule": ["* * * * 5,6,0"],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "addLabels": ["dependencies/rust"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["dependencies/github_actions"]
    },
    {
      "groupName": "rust-patch",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"]
    },
    {
      // Group SemVer-stable minor updates while keeping pre-1.0 minor updates
      // separate because they can contain breaking changes.
      "groupName": "rust-stable-minor",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0/"
    },
    {
      "groupName": "opentelemetry",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^opentelemetry([_-].*)?$/", "tracing-opentelemetry"]
    },
    {
      "groupName": "axum",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["axum", "axum-server", "async-graphql", "async-graphql-axum"]
    },
    {
      // Update Cargo.toml even when the new version already satisfies the
      // existing requirement, and keep Renovate commit titles concise.
      "matchManagers": ["cargo"],
      "rangeStrategy": "bump",
      "commitMessageTopic": "{{depName}}"
    }
  ]
}
